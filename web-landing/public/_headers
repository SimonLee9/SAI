# Cloudflare Pages headers — applied at edge. Vite copies public/ to dist/
# so this file ships verbatim with the build.

# Hashed assets are immutable — cache aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: minimum security headers, modest cache.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), camera=(), geolocation=()
  X-Frame-Options: DENY
