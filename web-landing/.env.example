# Copy to `.env.local` (gitignored) and fill in values for local dev.
# In production these are set in the Cloudflare Pages dashboard.

# URL of the deployed waitlist Worker. Leave unset for fully-local dev
# (the form will fall back to localStorage and tell the user so).
#
# Local dev with the worker running:
#   VITE_WAITLIST_ENDPOINT=http://localhost:8787
#
# Production:
#   VITE_WAITLIST_ENDPOINT=https://sai-waitlist.<account>.workers.dev
VITE_WAITLIST_ENDPOINT=
