# ============================================
# S.A.I Monorepo .gitignore
# ============================================

# --- PlatformIO (firmware/) ---
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# --- Python (dsp-tools/) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env

# --- Node.js (web-dashboard/) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# --- Build outputs ---
web-dashboard/dist/
web-dashboard/build/

# --- OS files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDE ---
.idea/
*.iml
.vscode/settings.json

# --- 3D Printing (hardware/) ---
# Keep STL/STEP files but ignore slicer temp files
*.gcode
*.3mf.bak
*.tmp

# --- Audio test files (large) ---
*.wav
*.mp3
*.flac
!dsp-tools/test-signals/*.wav

# --- Secrets ---
*.pem
*.key
secrets.yaml
config.local.*

# --- Logs ---
*.log
logs/
